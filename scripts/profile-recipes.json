{
  "orcaslicer": {
    "version": "2.4.2",
    "tag": "v2.4.2",
    "commit": "8500fcdccaa10b5099ac20d252af3a7c560046f1",
    "repository": "https://github.com/OrcaSlicer/OrcaSlicer",
    "profiles_path": "resources/profiles",
    "licence": "AGPL-3.0"
  },
  "authored_groups": {
    "bed_type_klipper": {
      "reason": "OrcaSlicer's CLI defaults curr_bed_type to 'Cool Plate' when no project file sets it (measured: M190 S35 with Generic PLA). Voron-class printers ship with a PEI spring-steel sheet; we pin the textured PEI plate so the filament's textured_plate_temp applies. The operator must match the sheet actually installed."
    },
    "bed_type_bambu": {
      "reason": "Same CLI default as above. The value is OrcaSlicer's own default_bed_type for the 'Bambu Lab A1' machine model (resources/profiles/BBL/machine/Bambu Lab A1.json), which the CLI does not apply on its own."
    },
    "tpu_safe": {
      "reason": "MADFAM authoring, not an OrcaSlicer value. The TPU 95A filament profiles cap volumetric flow at 3.2-3.6 mm3/s; at 0.2 mm layers and ~0.45 mm lines that is ~35-40 mm/s. Line speeds are set below that so the cap never silently rescales them, and accelerations are reduced for a soft filament in a direct-drive extruder. Not yet validated on a physical printer."
    }
  },
  "profiles": [
    {"id": "klipper-corexy-350-0.4", "version": 1, "kind": "printer", "target": "klipper_gcode",
     "label": {"es": "Impresora Klipper CoreXY 350 mm (clase Voron 2.4), boquilla 0.4", "en": "Klipper CoreXY 350 mm printer (Voron 2.4 class), 0.4 nozzle"},
     "base": {"vendor": "Voron", "name": "Voron 2.4 350 0.4 nozzle"},
     "set": {"curr_bed_type": {"value": "Textured PEI Plate", "group": "bed_type_klipper"}}},
    {"id": "bambu-a1-0.4", "version": 1, "kind": "printer", "target": "bambu_3mf",
