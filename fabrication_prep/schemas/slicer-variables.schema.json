{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madfam.io/schemas/fabrication-prep/slicer-variables.schema.json",
  "title": "fabrication-prep slicer-variables.json",
  "description": "What one slice job sliced (input and GOC-1 instance digests), with which versioned profiles and overrides, the effective process-parameters values the slicer reported, the slicer version, the output digest and the slicer's estimates. Canonical JSON (GOC-1 §3.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "job_id", "target", "input", "profiles", "material_class", "overrides",
               "requirements_sha256", "effective", "effective_sha256", "slicer", "output", "estimates", "warnings"],
  "properties": {
    "format": {"const": "madfam.fabrication-prep.slicer-variables"},
    "format_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "job_id": {"type": "string", "format": "uuid"},
    "target": {"enum": ["klipper_gcode", "bambu_3mf"]},
    "input": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "media_type", "bytes"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"enum": ["model/stl", "model/3mf"]},
                     "bytes": {"type": "integer", "minimum": 0}}
    },
    "generator_output": {
      "type": "object", "additionalProperties": false,
      "required": ["instance_id", "variables_sha256", "sidecar_sha256", "cartridge", "mode", "part", "complete"],
      "properties": {"instance_id": {"$ref": "#/$defs/sha256"}, "variables_sha256": {"$ref": "#/$defs/sha256"},
                     "sidecar_sha256": {"$ref": "#/$defs/sha256"}, "cartridge": {"type": "string"},
                     "mode": {"type": "string"}, "part": {"type": ["string", "null"]}, "complete": {"type": "boolean"}}
    },
    "profiles": {
      "type": "object", "additionalProperties": false, "required": ["printer", "process", "filament"],
      "properties": {"printer": {"$ref": "#/$defs/profile"}, "process": {"$ref": "#/$defs/profile"},
                     "filament": {"$ref": "#/$defs/profile"}}
    },
    "material_class": {"type": "string", "minLength": 1},
    "overrides": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean"]}},
    "requirements_sha256": {"$ref": "#/$defs/sha256"},
    "effective": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean"]}},
    "effective_sha256": {"$ref": "#/$defs/sha256"},
    "slicer": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"const": "OrcaSlicer"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"}}
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "media_type", "bytes", "filename"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"enum": ["text/x-gcode", "model/3mf"]},
                     "bytes": {"type": "integer", "minimum": 1}, "filename": {"type": "string"},
                     "gcode_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "estimates": {
      "type": "object", "additionalProperties": false, "required": ["source"],
      "properties": {"print_time_s": {"type": "integer", "minimum": 0}, "filament_g": {"type": "number", "minimum": 0},
                     "filament_mm": {"type": "number", "minimum": 0}, "filament_cm3": {"type": "number", "minimum": 0},
                     "source": {"enum": ["gcode", "slice_info.config+gcode"]}}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "properties": {
        "msg": {"type": ["string", "null"]}, "level": {"type": ["string", "null"]}, "error_code": {"type": ["string", "null"]}}}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"],
      "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
